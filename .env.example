# Token of the same Telegram bot that opens this Mini App in PuzzleBot.
BOT_TOKEN=123456789:replace_me

# Telegram supergroup IDs. The backend selects the report group strictly by role.
# For a server copy, put the test/report-copy group ID here before production rollout.
TRAINEE_CHAT_ID=-1000000000001
MENTOR_CHAT_ID=-1000000000002

# Username is shown only in the booking UI hint for Telegram notifications.
TELEGRAM_BOT_USERNAME=LOFT_HELPER_V2_BOT

# Telegram user IDs allowed to open the recruiter cabinet and write full booking state.
RECRUITER_TELEGRAM_IDS=1294774551,6774493976,1711587497,5950662713

# Persistent booking dates/applications database.
DATA_DIR=./data

# Optional migration/staging database. Production does not read it until the
# PostgreSQL storage adapter is explicitly enabled in a later stage.
DATABASE_URL=postgres://loft_internship:replace_me@127.0.0.1:35432/loft_internship_migration
POSTGRES_SSL_MODE=disable
POSTGRES_POOL_MAX=10

# Production remains "json". Use "postgres_readonly" only in migration staging
# after the copied JSON state has been imported and parity-checked.
BOOKING_STORAGE_MODE=json

# Set to "yes" only in staging/test copies that use production-like data.
SUPPRESS_TRAINEE_NOTIFICATIONS=no

# "dry_run" blocks every outbound Telegram message and photo, including report
# groups, while keeping validation and state changes available for staging QA.
TELEGRAM_DELIVERY_MODE=live

# PostgreSQL outbox worker. In production Postgres mode this worker must run,
# otherwise state changes are saved but queued Telegram messages stay pending.
NOTIFICATION_WORKER_INTERVAL_MS=15000
NOTIFICATION_WORKER_LIMIT=20
NOTIFICATION_WORKER_MAX_ATTEMPTS=3
NOTIFICATION_WORKER_RETRY_DELAY_MS=60000
# Optional safety cutoff for first live enablement, e.g. 2026-08-22T12:00:00.000Z.
# Rows created before this timestamp stay pending until handled manually.
NOTIFICATION_WORKER_CREATED_AFTER=

# Keep "no" when the bot is connected to PuzzleBot.
TELEGRAM_POLLING=no

# A checklist may stay open during a long shift, so the default is 24 hours.
INIT_DATA_TTL_SECONDS=86400

HOST=0.0.0.0
PORT=3000
