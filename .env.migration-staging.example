# Copy production bot/auth values here. Telegram delivery is still forced to
# dry_run by deploy/docker-compose.migration-staging.yml.
BOT_TOKEN=123456789:replace_me
TRAINEE_CHAT_ID=-1000000000001
MENTOR_CHAT_ID=-1000000000002
TELEGRAM_BOT_USERNAME=LOFT_HELPER_V2_BOT
RECRUITER_TELEGRAM_IDS=1294774551,6774493976,1711587497,5950662713
INIT_DATA_TTL_SECONDS=86400

# Use a long unique password. This file must stay untracked on the server.
POSTGRES_DB=loft_internship_migration_staging
POSTGRES_USER=loft_internship_migration
POSTGRES_PASSWORD=replace_with_long_random_password
DATABASE_URL=postgres://loft_internship_migration:replace_with_long_random_password@postgres-migration-staging:5432/loft_internship_migration_staging
POSTGRES_SSL_MODE=disable
POSTGRES_POOL_MAX=10

# Repeated here for clarity; compose enforces the same safety values.
BOOKING_STORAGE_MODE=postgres_readonly
TELEGRAM_DELIVERY_MODE=dry_run
TELEGRAM_POLLING=no
SUPPRESS_TRAINEE_NOTIFICATIONS=yes
